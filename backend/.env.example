GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=accesspilot
# Choose a PEM path OR an environment variable containing the PEM (literal \n supported).
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/accesspilot.pem
GITHUB_PRIVATE_KEY=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
N8N_WEBHOOK_URL=https://your-workspace.app.n8n.cloud/webhook/your-production-webhook
N8N_WEBHOOK_SECRET=
# Source-service credentials are generated per job and delivered only to n8n.
# Configure a trusted HTTPS source base URL in the n8n workflow if using callbacks;
# never put a browser session or GitHub token in n8n configuration.
# For a Quick Tunnel use: python -m backend.run --tunnel
# This disables API documentation; the launcher disables access logs and proxy trust.
TUNNEL_MODE=false
# Bounded background scans (one FastAPI worker; no Redis/queue service required).
SCAN_CONCURRENCY=2
SCAN_QUEUE_SIZE=20
# MongoDB Atlas connection string. Use a dedicated database user, not an admin account.
# Example: mongodb+srv://accesspilot:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DATABASE=accesspilot
MONGO_SCAN_COLLECTION=scan_results
# Absolute writable path; install Chromium into this same directory.
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/accesspilot/.cache/ms-playwright
